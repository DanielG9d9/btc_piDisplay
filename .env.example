# Example .env file — commit this one instead of your real .env
# Copy to .env and fill in your actual values.
GLASSNODE_API_KEY=your_glassnode_api_key_here

# Optional: a receive address to display as a QR code on the Node screen,
# next to the balance it fetches from blockcypher. Leave unset to skip the
# QR panel entirely. Just an address (not an xpub) — see readme.md.
WALLET_ADDRESS=1FpaYV2cTk1W7WtHhsRP2kuNtKynNbeGoH

# One block per RPC node profile. The profile name (NUC1 below) must match an
# entry in config.json's "connect_to" — uppercase it here for the env var names.
# Add another block with a different name to define additional node profiles.
RPC_NUC1_USER=your_rpc_username
RPC_NUC1_HOST=192.168.1.100
RPC_NUC1_PASSWORD=your_rpc_password
RPC_NUC1_PORT=8332
